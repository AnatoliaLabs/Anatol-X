#!/bin/sh
set -e

echo "Anatol-X: KDE Başlat menüsü logosu ayarlanıyor..."

# Kullanıcılar için varsayılan Plasma yapılandırma dizinini oluştur
mkdir -p /etc/skel/.config

# KDE Kickoff (Başlat) menüsünün ikonunu anatol-x-logo.jpg yap
cat << 'EOF' > /etc/skel/.config/plasma-org.kde.plasma.desktop-appletsrc
[ActionPlugins][0]
RightButton;NoModifier=org.kde.contextmenu

[Containments][1]
ItemGeometriesHorizontal=
ItemGeometriesVertical=
activityId=
plugin=org.kde.panel
wallpaperplugin=org.kde.image

[Containments][1][Applets][2]
immutability=1
plugin=org.kde.plasma.kickoff

[Containments][1][Applets][2][Configuration][General]
icon=/usr/share/pixmaps/anatol-x-logo.jpg
EOF

# Mevcut ayarları sistem genelinde uygulanabilir yap
chmod -R 755 /etc/skel/.config
